# Local development only. Production defaults fail closed.
EMP_ENVIRONMENT=development
EMP_APP_ORIGIN=http://localhost:5173
EMP_DATABASE_URL=postgresql+psycopg://emp_local:local-only-password@127.0.0.1:5433/emp_local
# Configure privately for a live Google login; leave blank for health/login-gate development.
EMP_GOOGLE_CLIENT_ID=
EMP_GOOGLE_CLIENT_SECRET=
EMP_ALLOWED_EMAILS=[]
# Event Marketing Event-intake defaults (suggestions are not canonical until accepted).
EMP_DEFAULT_TIMEZONE=America/Denver
EMP_DEFAULT_VENUE_NAME=Example Conference Center
EMP_DEFAULT_VENUE_STREET=100 Main St
EMP_DEFAULT_VENUE_CITY=Springfield
EMP_DEFAULT_VENUE_REGION=CO
EMP_DEFAULT_VENUE_POSTAL_CODE=80202
# Server-owned destination plan defaults. LIVE requires privately configured, reviewed connector readiness.
EMP_EVENTBRITE_EXECUTION_MODE=SIMULATED
EMP_MEETUP_EXECUTION_MODE=SIMULATED
EMP_LINKEDIN_ORGANIZATION_EXECUTION_MODE=SIMULATED
EMP_INSTAGRAM_EXECUTION_MODE=SIMULATED
# Instagram API with Instagram Login; this is the current supported version as of 2026-10-07.
EMP_INSTAGRAM_GRAPH_API_VERSION=v26.0
# Instagram Professional-account target. The username is display-only; numeric ID is authoritative.
EMP_INSTAGRAM_PROFESSIONAL_ACCOUNT_ID=
EMP_INSTAGRAM_USERNAME=
# Public HTTPS origin used only for short-lived, signed approved-graphic delivery to Meta.
PUBLIC_MEDIA_BASE_URL=
# Deployment secret, at least 32 characters; never commit a real value.
MEDIA_DELIVERY_SIGNING_SECRET=
# LinkedIn Marketing API version from the currently supported allowlist; keep current.
EMP_LINKEDIN_API_VERSION=202609
# LinkedIn member OAuth app setup (server only). These values do not enable LIVE by themselves.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ORGANIZATION_NAME=
# Set only after Community Management tier is confirmed in the LinkedIn Developer Portal.
LINKEDIN_COMMUNITY_ACCESS_TIER=UNVERIFIED
# Instagram Login app setup (server only). These values do not enable LIVE by themselves.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
# OAuth token encryption keyring. Keep this absolute path outside the repository.
# Provision a random key with `python -m scripts.credential_vault generate-key --key-id <id>`.
CREDENTIAL_VAULT_KEYRING_PATH=
CREDENTIAL_VAULT_ACTIVE_KEY_ID=
# Live Eventbrite (V1 private token, server-side only). Used only when Eventbrite mode is LIVE.
# Leave blank unless operating live publishing; never commit real values.
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_ORGANIZATION_ID=
EVENTBRITE_ORGANIZER_ID=
EVENTBRITE_CURRENCY=USD
# Optional operator draft write test (create/verify/delete synthetic draft); off by default.
EVENTBRITE_ENABLE_LIVE_WRITE_TEST=0
# Live Meetup JWT-owner configuration. Keep the RSA key outside this repository.
MEETUP_CLIENT_KEY=
MEETUP_AUTHORIZED_MEMBER_ID=
MEETUP_SIGNING_KEY_ID=
MEETUP_PRIVATE_KEY_PATH=
MEETUP_NETWORK_URLNAME=
MEETUP_GROUP_URLNAME=
# Optional synthetic DRAFT test requires both flags; it never publishes.
MEETUP_ENABLE_LIVE_WRITE_TEST=0
MEETUP_ENABLE_VERIFIED_DRAFT_CLEANUP=0
# Development/test can use the visibly deterministic demo extractor. Production requires openai.
EMP_EXTRACTION_MODE=fake
# Campaign generation/revision is offline/fake by default outside production. Production requires openai.
EMP_CAMPAIGN_GENERATION_MODE=fake
OPENAI_EXTRACTION_MODEL=gpt-6-luna
OPENAI_CAMPAIGN_MODEL=gpt-6-luna
# Graphic generation is deterministic/offline in local development; production requires openai.
EMP_IMAGE_GENERATION_MODE=fake
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Facebook Group ranking is deterministic/offline locally; production requires openai.
EMP_GROUP_RECOMMENDATION_MODE=fake
OPENAI_GROUP_RECOMMENDATION_MODEL=gpt-6-luna
OPENAI_API_KEY=
# Tests create/drop disposable emp_test_* databases on the local Compose PostgreSQL.
TEST_DATABASE_URL=postgresql+psycopg://emp_local:local-only-password@127.0.0.1:5433/emp_test
